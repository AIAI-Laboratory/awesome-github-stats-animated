{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisq.dev/schemas/github-stats-template.json",
  "title": "AIAI GitHub Stats template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "version", "author", "license", "entry", "width", "height", "tags", "options"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "description": { "type": "string", "minLength": 20, "maxLength": 180 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "author": { "type": "string", "minLength": 2, "maxLength": 80 },
    "license": { "type": "string", "minLength": 2, "maxLength": 30 },
    "entry": { "const": "./index.js" },
    "width": { "type": "integer", "minimum": 320, "maximum": 1600 },
    "height": { "type": "integer", "minimum": 160, "maximum": 900 },
    "tags": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "options": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "default", "description"],
        "properties": {
          "type": { "enum": ["color", "string", "boolean", "number", "select"] },
          "default": {},
          "description": { "type": "string", "minLength": 8, "maxLength": 140 },
          "choices": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    }
  }
}
